rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /locations/{locationId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'atr000@gmail.com' && request.auth.token.email_verified == true;
    }
    match /runs/{runId} {
      allow read: if request.auth != null && request.auth.token.email == 'atr000@gmail.com' && request.auth.token.email_verified == true;
      allow write: if false;
    }
  }
}
