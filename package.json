{
  "name": "sunsethue-helper",
  "version": "1.17.0",
  "description": "Daily sunrise/sunset quality email notifier on Cloudflare Pages, Workers, D1, and Access.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "test": "node --test scripts/test-frontend.js scripts/test-frontend-unit.mjs test/*.test.mjs",
    "test:coverage": "node --test scripts/test-frontend.js scripts/test-frontend-unit.mjs test/*.test.mjs",
    "preview:email": "node scripts/preview-email.js",
    "access:snapshot": "node scripts/cloudflare-access.mjs snapshot",
    "access:apply": "node scripts/cloudflare-access.mjs apply",
    "access:verify": "node scripts/cloudflare-access.mjs verify",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "dependencies": {
    "jose": "6.2.5",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^10.5.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "wrangler": "4.115.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix"
    ]
  }
}
