{
  "name": "sunsethue-helper",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "description": "Daily sunrise/sunset quality email notifier on Cloudflare Pages, Workers, D1, and Access.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewtryder/sunsethue-helper.git"
  },
  "bugs": {
    "url": "https://github.com/andrewtryder/sunsethue-helper/issues"
  },
  "homepage": "https://github.com/andrewtryder/sunsethue-helper#readme",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "lint": "eslint .",
    "lint:shell": "bash scripts/lint-shell.sh",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "audit": "npm audit --audit-level=high",
    "audit:release": "node scripts/public-release-audit.mjs",
    "security:scan": "trufflehog git file://. --results=verified,unknown --fail",
    "config:generate": "node scripts/generate-wrangler-config.mjs",
    "config:generate:strict": "node scripts/generate-wrangler-config.mjs --strict",
    "validate:wrangler": "bash scripts/validate-wrangler.sh",
    "test": "npm run test:frontend && npm run test:worker && npm run test:integration",
    "test:frontend": "node --test scripts/test-frontend.js scripts/test-frontend-unit.mjs",
    "test:worker": "node --test 'test/unit/*.test.mjs'",
    "test:integration": "node --test 'test/integration/*.test.mjs'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=worker/** --test-coverage-include=functions/** --test-coverage-include=public/lib/** --test-coverage-lines=95 --test-coverage-branches=88 --test-coverage-functions=95 scripts/test-frontend.js scripts/test-frontend-unit.mjs 'test/unit/*.test.mjs' 'test/integration/*.test.mjs'",
    "ci": "npm run lint && npm run audit && npm run lint:shell && npm run lint:workflows && npm run validate:wrangler && npm run test:coverage",
    "db:schema:local": "node scripts/db-schema-local.mjs",
    "db:schema:remote": "node scripts/db-schema-remote.mjs",
    "secrets:upload": "node scripts/upload-worker-secrets.mjs",
    "secrets:upload:admin": "node scripts/upload-worker-secrets.mjs --target=admin",
    "secrets-store:bootstrap": "node scripts/secrets-store-bootstrap.mjs",
    "secrets-store:preflight": "node scripts/secrets-store-preflight.mjs",
    "deploy:prepare": "node scripts/prepare-deployment.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "rollback:production": "node scripts/rollback-production.mjs",
    "access:snapshot": "node scripts/cloudflare-access.mjs snapshot",
    "access:plan": "node scripts/cloudflare-access.mjs plan",
    "access:apply": "node scripts/cloudflare-access.mjs apply",
    "access:verify": "node scripts/cloudflare-access.mjs verify",
    "preview:email": "node scripts/preview-email.js",
    "prepare": "husky"
  },
  "dependencies": {
    "jose": "6.2.5",
    "worker-mailer": "1.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "wrangler": "4.115.0",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix"
    ]
  }
}
