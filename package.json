{
  "name": "sunsethue-helper",
  "version": "1.10.3",
  "description": "Daily sunrise/sunset quality email notifier using Sunsethue API and Firebase.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "commitplease": "commitplease",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "test": "node scripts/test-frontend.js && node scripts/test-frontend-unit.mjs",
    "test:coverage": "node scripts/test-frontend.js && node scripts/test-frontend-unit.mjs",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:all": "npm test && npm run test:e2e",
    "preview:email": "node scripts/preview-email.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "commitplease": "^3.2.0",
    "eslint": "^10.5.0",
    "eslint-plugin-security": "^4.0.1"
  },
  "commitplease": {
    "style": "angular",
    "nohook": true,
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "limits": {
      "firstLine": "72",
      "otherLine": "80"
    }
  }
}
