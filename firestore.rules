rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /locations/{locationId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'atr000@gmail.com';
    }
    match /runs/{runId} {
      allow read: if request.auth != null && request.auth.token.email == 'atr000@gmail.com';
      allow write: if false;
    }
  }
}
