# Copy to .env for local Access automation, config generation, and deploy scripts.
# Never commit the real .env file.
#
# Non-secret instance identity (also set as GitHub environment variables):
PAGES_PROJECT_NAME=your-pages-project
WORKER_NAME=your-worker-name
D1_DATABASE_NAME=your-d1-database
PRODUCTION_HOSTNAME=your-pages-project.pages.dev
PRODUCTION_URL=https://your-pages-project.pages.dev
ACCESS_HOSTNAME=your-pages-project.pages.dev
DEPLOY_REPOSITORY=your-github-org/your-repo

# Sensitive values (also set as GitHub environment secrets):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
AUTHORIZED_EMAIL=owner@example.com
CONTACT_EMAIL=owner@example.com
TEAM_DOMAIN=https://your-team.cloudflareaccess.com
POLICY_AUD=
SUNSETHUE_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=owner@example.com
EMAIL_FROM="Sunsethue Helper" <owner@example.com>
